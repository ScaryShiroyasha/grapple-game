[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float Cload_speed;
uniform sampler2D tex_vtx_5;
uniform float Cloud_intensity;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D tex_frg_15;
uniform sampler2D depth_tex_frg_21 : hint_depth_texture;
uniform vec4 Explosion_color : source_color = vec4(1.000000, 0.284935, 0.000000, 1.000000);
uniform float Color_intensity = 20.0;
uniform sampler2D tex_frg_12;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:3
	vec3 n_out3p0 = NORMAL;


// Input:9
	float n_out9p0 = TIME;


// FloatParameter:12
	float n_out12p0 = Cload_speed;


// VectorOp:10
	vec2 n_out10p0 = vec2(n_out9p0) * vec2(n_out12p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out10p0 * n_in8p1 + UV;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_vtx_5, n_out8p0);


// FloatParameter:11
	float n_out11p0 = Cloud_intensity;


// FloatOp:7
	float n_out7p0 = n_out5p0.x * n_out11p0;


// VectorOp:6
	vec3 n_out6p0 = n_out3p0 * vec3(n_out7p0);


// VectorOp:4
	vec3 n_out4p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p1 = n_out2p0.r;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out2p1));


// Input:19
	vec4 n_out19p0 = COLOR;
	float n_out19p4 = n_out19p0.a;


// Texture2D:15
	vec4 n_out15p0 = texture(tex_frg_15, UV);
	float n_out15p1 = n_out15p0.r;


// SmoothStep:16
	float n_in16p1 = 1.00000;
	float n_out16p0 = smoothstep(n_out19p4, n_in16p1, n_out15p1);


	float n_out21p0;
// ProximityFade:21
	float n_in21p0 = 1.00000;
	{
		float __depth_tex = texture(depth_tex_frg_21, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out21p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in21p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:22
	float n_out22p0 = n_out16p0 * n_out21p0;


// ColorParameter:4
	vec4 n_out4p0 = Explosion_color;


// FloatParameter:6
	float n_out6p0 = Color_intensity;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0.xyz) * vec3(n_out6p0);


// Input:20
	vec4 n_out20p0 = COLOR;
	float n_out20p1 = n_out20p0.r;


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, UV);
	float n_out12p1 = n_out12p0.r;


// SmoothStep:10
	float n_in10p1 = 1.00000;
	float n_out10p0 = smoothstep(n_out20p1, n_in10p1, n_out12p1);


// VectorOp:9
	vec3 n_out9p0 = n_out5p0 * vec3(n_out10p0);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out22p0;
	EMISSION = n_out9p0;


}
